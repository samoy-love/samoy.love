# Описание цели выкатки. Читают и CI (reusable workflow из deploy-kit),
# и локальный `deploy-kit/bin/deploy --config .deploy-kit/prod.env`.
#
# Хост, пользователь и ключ берутся из секретов репозитория (в CI) или из
# окружения (локально) — здесь их сознательно нет.

APP=samoy-love
BUILD_CMD="npm ci && npm run build"
ARTIFACT_DIR=dist

# Корень с releases/ и симлинком current. nginx смотрит именно в current,
# поэтому переключение релиза атомарно для посетителя.
ROOT=/var/www/samoy.love
OWNER=ubuntu:ubuntu

# Статике не нужен перезапуск сервиса — только reload nginx.
NGINX_RELOAD=1
NGINX_DEST=/etc/nginx/sites-available/samoy.love.conf

HEALTH=https://samoy.love/
VERSION_URL=https://samoy.love/version.json

# Соседи по nginx: ошибка в нашем конфиге роняет их домены, поэтому после
# выкатки проверяем, что они живы.
NEIGHBOURS=metro.samoy.love,snakes.samoy.love,launcher.samoy.love,status.samoy.love

KEEP=5
