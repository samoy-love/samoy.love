# Описание цели выкатки. Читают и CI (reusable workflow из deploy-kit),
# и локальный `deploy-kit/bin/deploy --config .deploy-kit/prod.env`.
#
# Хост, пользователь и ключ берутся из секретов репозитория (в CI) или из
# окружения (локально) — здесь их сознательно нет.

APP=samoylove
BUILD_CMD="npm ci && npm run build"
ARTIFACT_DIR=dist

# Корень с releases/ и симлинком current. nginx смотрит именно в current,
# поэтому переключение релиза атомарно для посетителя.
ROOT=/var/www/samoy.love
OWNER=ubuntu:ubuntu

# Статике не нужен перезапуск сервиса — только reload nginx.
NGINX_RELOAD=1

# Конфиг nginx описывается ПАРОЙ строк: что ставить и куда. Одной половины не
# бывает — это не «настроено наполовину», а молча пропущенный шаг: выкатка
# просто не выполняет ни скачивание конфига, ни его проверку, ни установку, и
# остаётся зелёной. Здесь годами стоял один NGINX_DEST, и всё это время правки
# в deploy-kit/nginx/sites/samoy.love.conf не доезжали до сервера ни одним
# пайплайном — файл на проде жил своей жизнью и обновлялся руками.
#
# NGINX_CONF — путь ВНУТРИ репозитория deploy-kit (оттуда его и качает
# выкатка), NGINX_DEST — абсолютный путь на сервере. Копии конфига в этом
# репозитории нет и не должно быть: конфигурация живёт только в deploy-kit.
NGINX_CONF=nginx/sites/samoy.love.conf
NGINX_DEST=/etc/nginx/sites-available/samoy.love.conf

HEALTH=https://samoy.love/
VERSION_URL=https://samoy.love/version.json

# О релизе сообщает БОТ статус-страницы, а не выкатка, — поэтому здесь тишина.
#
# Голос ровно один, и это принципиально. Агент статус-страницы раз в минуту
# читает VERSION_URL (та же строка выше, проект `samoylove` в
# samoy-status/config/status.json), видит смену версии и пишет в чат. Причём
# пишет он о РАБОТАЮЩЕМ на проде, а не о завершившемся пайплайне: зелёная
# выкатка со старыми файлами до чата не доходит.
#
# Включить второй голос — значит получить два сообщения об одном релизе:
# «выкачено» от Actions и «поехало» от бота. Отличать их в ленте пришлось бы
# глазами, а «поехало» от бота содержит ещё и список изменений.
#
# never, а не пустой секрет: молчание должно быть заявленным. Пайплайн иначе
# честно ругается предупреждением «о релизе никто не узнал» на каждой выкатке,
# и настоящая потеря уведомлений становится неотличима от нашей — именно так
# пять репозиториев годами не слали ни одного сообщения, и никто не заметил.
# Строку читает шаг уведомления ДО проверки токена, так что TELEGRAM_* в
# секретах этого репозитория не нужны и заводить их не надо.
#
# Про провалы `never` тоже молчит, и это осознанно, а не недосмотр. Напрашивается
# NOTIFY=fail («об успехе молчим, о провале говорим») — но чтобы что-то
# сказать, нужны TELEGRAM_* в секретах ЭТОГО репозитория, а их здесь нет и не
# будет: единственный чат держит бот. Без них `fail` не пришлёт ни одного
# сообщения о провале и вместо этого будет вешать предупреждение на КАЖДУЮ
# выкатку — то есть обещание, которое не выполняется, плюс шум, в котором
# тонет настоящая поломка. Невыкаченное видно там же, где и всё остальное:
# красный запуск в Actions и не сменившаяся версия на проде.
NOTIFY=never

# Соседи по nginx: ошибка в нашем конфиге роняет их домены, поэтому после
# выкатки проверяем, что они живы.
NEIGHBOURS=metro.samoy.love,snakes.samoy.love,launcher.samoy.love,die.samoy.love,status.samoy.love

KEEP=5

# ------------------------------------------------------------ локальный запуск
#
# Ключи RUN_* читает `dk run`.
#
# Порт назван явно, хотя 4321 — и так дефолт Astro. Дефолт здесь опасен:
# статус-страница тоже стоит на Astro и тоже хочет 4321, а Astro при занятом
# порте МОЛЧА уезжает на 4322. Запусти оба сайта разом — и второй окажется не
# там, где его ждут ссылки и e2e, причём без единой строчки в логе. Поэтому
# главная закреплена за 4321, а статус — за 4331.
RUN_CMD="npm run dev -- --port %PORT%"
RUN_PORT=4321
