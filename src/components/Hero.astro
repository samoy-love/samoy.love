---
import profile from '../data/profile.json';
import achievements from '../data/achievements.json';

const byId = new Map(achievements.map((a) => [a.id, a]));
const featured = profile.featuredAchievements
  .map((id) => byId.get(id))
  .filter(Boolean);
---

<header class="hero">
  <div class="scene" aria-hidden="true">
    <canvas id="hero-canvas"></canvas>
    <div class="grid-overlay"></div>
    <div class="vignette"></div>
  </div>

  <div class="hero-inner container">
    <div class="identity">
      <p class="mono kicker"><span class="prompt">$</span> whoami<span class="cursor">▊</span></p>
      <h1>{profile.name}</h1>
      <p class="class-line">{profile.class}</p>
      <p class="tagline">{profile.tagline}</p>

      <div class="cta">
        <a class="btn btn-accent" href="#path">Мой путь ↓</a>
        <a class="btn" href="#work">Работа</a>
        <a class="btn" href="#pet">Pet-проекты</a>
      </div>

      <p class="mono status"><span class="status-dot" aria-hidden="true"></span> {profile.status}</p>
    </div>

    <aside class="sheet" aria-label="Карточка персонажа">
      <p class="mono sheet-head">// character sheet</p>

      <div class="sheet-block">
        <p class="mono block-label">скиллы</p>
        <ul class="skills" role="list">
          {profile.skills.map((s) => (
            <li class="skill-row">
              <span class="skill-name">{s.name}</span>
              <span class="mono skill-note">{s.note}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="sheet-block">
        <p class="mono block-label">текущий квест</p>
        <p class="quest">{profile.currentQuest}</p>
      </div>

      <div class="sheet-block ach-block">
        <p class="mono block-label">последние ачивки</p>
        <ul class="ach-row" role="list">
          {featured.map((a) => (
            <li class:list={['chip', a!.rarity]} title={a!.note}>
              <span aria-hidden="true">{a!.icon}</span> {a!.title}
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <ul class="metrics" role="list">
      {profile.stats.map((s) => (
        <li>
          <span class="metric-value">{s.value}</span>
          <span class="metric-label">{s.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <a class="scroll-hint mono" href="#path" aria-hidden="true" tabindex="-1">scroll ↓</a>
</header>

<script>
  // Уровень эффектов решается ДО загрузки модуля: на Lite/Static устройства
  // ~15 КБ WebGL-кода даже не скачиваются. Фолбэк — CSS-фон в .scene.
  const nav = navigator as Navigator & { deviceMemory?: number };
  const weak = (nav.hardwareConcurrency ?? 8) <= 4 || (nav.deviceMemory ?? 8) <= 4;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let dispose: (() => void) | null = null;

  // astro:page-load вместо прямого вызова: с ClientRouter этот модуль
  // выполняется один раз, а канвас после каждой навигации новый.
  document.addEventListener('astro:page-load', () => {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    if (!canvas) return; // не главная страница

    if (reduced || weak) {
      canvas.remove();
      return;
    }

    import('../islands/hero-scene')
      .then(({ initHeroScene }) => {
        dispose = initHeroScene(canvas);
        if (!dispose) canvas.remove();
      })
      .catch(() => canvas.remove());
  });

  // Уходя со страницы, гасим сцену: иначе rAF продолжает рисовать в
  // выброшенный канвас, а каждый визит на главную плодит новый контекст.
  document.addEventListener('astro:before-swap', () => {
    dispose?.();
    dispose = null;
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: clip;
    padding-top: 4.5rem;
  }

  /* ---- многослойный фон ---- */
  .scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(85rem 45rem at 78% -12%, oklch(0.3 0.07 210 / 0.5), transparent 62%),
      radial-gradient(60rem 38rem at -8% 108%, oklch(0.27 0.07 300 / 0.42), transparent 60%),
      radial-gradient(40rem 30rem at 95% 85%, oklch(0.25 0.06 55 / 0.25), transparent 65%);
  }
  .scene canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in oklch, var(--accent) 7%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklch, var(--accent) 7%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 60% at 50% 45%, black 30%, transparent 100%);
  }
  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 40%, transparent 55%, oklch(0.1 0.015 260 / 0.75) 100%);
  }

  /* ---- сетка контента ---- */
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(1.2rem, 4vw, 3.5rem);
    padding-block: 2rem 3.5rem;
  }
  @media (min-width: 880px) {
    .hero-inner {
      grid-template-columns: 1.25fr 1fr;
      align-items: center;
      padding-block: 3rem 4.5rem;
    }
    .metrics { grid-column: 1 / -1; }
  }

  /* Мобильный порядок: сначала имя и цифры — самое цепляющее, панель ниже.
     Иначе первый экран занимала бы длинная карточка персонажа. */
  @media (max-width: 879px) {
    .metrics { order: 2; }
    .sheet { order: 3; }
    /* Ачивки здесь дублируют трофейную полку в секции «Путь» — на узком
       экране это лишняя высота. */
    .sheet .ach-block { display: none; }
  }

  /* ---- левая колонка ---- */
  .kicker { color: var(--accent); margin-bottom: 1.1rem; font-size: 0.9rem; }
  .prompt { color: var(--accent-warm); }
  .cursor { animation: blink 1.1s steps(1) infinite; margin-left: 2px; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }

  h1 {
    font-size: clamp(2.5rem, 6.5vw, 4.6rem);
    font-weight: 830;
    background: linear-gradient(180deg, var(--text), color-mix(in oklch, var(--text) 55%, var(--accent)));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 28px color-mix(in oklch, var(--accent) 22%, transparent));
  }

  .class-line {
    margin-top: 0.8rem;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    font-weight: 680;
  }

  .tagline {
    margin-top: 0.9rem;
    color: var(--text-dim);
    font-size: 1.02rem;
    max-width: 42ch;
  }

  .cta {
    margin-top: 1.8rem;
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .status {
    margin-top: 1.5rem;
    color: var(--text-dim);
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: oklch(0.8 0.2 150);
    box-shadow: 0 0 10px oklch(0.8 0.2 150 / 0.8);
  }
  @media (prefers-reduced-motion: no-preference) {
    .status-dot { animation: pulse 2.4s ease-in-out infinite; }
    @keyframes pulse { 50% { opacity: 0.45; } }
  }

  /* ---- панель персонажа ---- */
  .sheet {
    border: 1px solid color-mix(in oklch, var(--accent) 22%, var(--line));
    border-radius: calc(var(--radius) + 6px);
    background: color-mix(in oklch, var(--bg-raise) 78%, transparent);
    backdrop-filter: blur(16px);
    padding: clamp(1rem, 3vw, 1.4rem) clamp(1.1rem, 3vw, 1.5rem);
    box-shadow:
      0 24px 70px oklch(0.05 0.01 260 / 0.5),
      inset 0 1px 0 color-mix(in oklch, var(--text) 8%, transparent);
  }
  .sheet-head {
    color: var(--accent);
    font-size: 0.8rem;
    margin-bottom: 1.1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
  }
  .sheet-block + .sheet-block { margin-top: 1.2rem; }
  .block-label {
    color: var(--text-dim);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.6rem;
  }

  .skills { list-style: none; padding: 0; margin: 0; }
  .skill-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.8rem;
    font-size: 0.88rem;
    padding: 0.42rem 0;
  }
  .skill-row + .skill-row { border-top: 1px solid var(--line); }
  .skill-name { font-weight: 620; white-space: nowrap; }
  .skill-note { color: var(--text-dim); font-size: 0.72rem; text-align: right; }

  .quest { font-size: 0.92rem; }

  .ach-row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  /* ---- метрики ---- */
  .metrics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(140px, 45%), 1fr));
    gap: 0.6rem;
  }
  .metrics li {
    text-align: center;
    padding: clamp(0.7rem, 2.5vw, 1rem) 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in oklch, var(--bg-raise) 60%, transparent);
    backdrop-filter: blur(10px);
  }
  .metric-value {
    display: block;
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 750;
    color: var(--accent);
    text-shadow: 0 0 24px color-mix(in oklch, var(--accent) 40%, transparent);
  }
  .metric-label {
    display: block;
    margin-top: 0.2rem;
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  .scroll-hint {
    position: absolute;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    left: 50%;
    translate: -50% 0;
    z-index: 1;
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .scroll-hint:hover { text-decoration: none; color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-hint { animation: hint-bob 2.4s ease-in-out infinite; }
    @keyframes hint-bob {
      0%, 100% { translate: -50% 0; }
      50% { translate: -50% 8px; }
    }
  }
</style>
