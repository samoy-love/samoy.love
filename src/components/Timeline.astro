---
import timeline from '../data/timeline.json';
import achievements from '../data/achievements.json';

const byId = new Map(achievements.map((a) => [a.id, a]));
const rare = achievements.filter((a) => a.rarity === 'rare').length;
const last = timeline.length - 1;
---

<section id="path" class="container">
  <p class="section-label">// 01 — прокачка</p>
  <h2 class="section-title">Путь персонажа</h2>
  <p class="section-lead">От первой игры на школьных переменах до команды в Почте Mail.ru — весь маршрут, с фактами и разблокированными ачивками.</p>

  <div class="duo">
    <ol class="timeline" role="list">
      {timeline.map((step, i) => (
        <li class:list={['step reveal', { now: i === last }]}>
          <div class="node mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
          <div class="step-card">
            <div class="step-head">
              <p class="mono period">{step.period}</p>
              {i === last && <span class="mono now-tag">сейчас</span>}
            </div>
            <h3>{step.title}</h3>
            <p class="step-text">{step.text}</p>
            <p class="fact"><span class="mono fact-label">факт:</span> {step.fact}</p>
            {step.achievements.length > 0 && (
              <ul class="step-achievements" role="list">
                {step.achievements.map((id) => {
                  const a = byId.get(id);
                  return a ? (
                    <li class:list={['chip', a.rarity]} title={a.note}>
                      <span aria-hidden="true">{a.icon}</span> {a.title}
                    </li>
                  ) : null;
                })}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    <aside class="shelf reveal" aria-label="Достижения">
      <div class="shelf-head">
        <p class="mono shelf-title">// трофейная полка</p>
        <p class="mono shelf-count">{achievements.length}/{achievements.length} · rare ×{rare}</p>
      </div>
      <div class="xp" role="img" aria-label={`Разблокировано ${achievements.length} из ${achievements.length} достижений`}>
        <div class="xp-fill"></div>
      </div>

      <ul class="tiles" role="list">
        {achievements.map((a) => (
          <li class:list={['tile', a.rarity]}>
            {a.rarity === 'rare' && <span class="mono rare-star" aria-hidden="true">★</span>}
            <span class="slot" aria-hidden="true">{a.icon}</span>
            <p class="t-title">{a.title}</p>
            <p class="t-note">{a.note}</p>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<style>
  .duo {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .duo { grid-template-columns: 1.05fr 0.95fr; gap: 2.6rem; }
    .shelf { position: sticky; top: 5rem; }
  }

  /* ================= таймлайн ================= */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 14px;
    top: 10px;
    bottom: 30px;
    width: 2px;
    background: linear-gradient(180deg, var(--accent), color-mix(in oklch, var(--accent) 30%, transparent));
    opacity: 0.4;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline::before {
        transform-origin: top;
        animation: draw-line linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 70%;
      }
      @keyframes draw-line {
        from { scale: 1 0; }
        to { scale: 1 1; }
      }
    }
  }

  .step {
    position: relative;
    padding: 0 0 1rem 2.9rem;
  }
  .step:last-child { padding-bottom: 0; }

  .node {
    position: absolute;
    left: 0;
    top: 4px;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--bg);
    border: 1px solid color-mix(in oklch, var(--accent) 55%, transparent);
    box-shadow: 0 0 14px color-mix(in oklch, var(--accent) 35%, transparent);
  }
  .step.now .node {
    color: var(--bg);
    background: var(--accent);
    box-shadow: 0 0 22px color-mix(in oklch, var(--accent) 70%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .step.now .node { animation: node-pulse 2.6s ease-in-out infinite; }
    @keyframes node-pulse {
      50% { box-shadow: 0 0 8px color-mix(in oklch, var(--accent) 35%, transparent); }
    }
  }

  .step-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in oklch, var(--bg-raise) 75%, transparent);
    padding: 0.85rem 1rem 0.95rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .step-card:hover {
    border-color: color-mix(in oklch, var(--accent) 40%, transparent);
    box-shadow: 0 4px 24px color-mix(in oklch, var(--accent) 10%, transparent);
  }
  .step.now .step-card {
    border-color: color-mix(in oklch, var(--accent) 45%, transparent);
    background: color-mix(in oklch, var(--accent) 5%, var(--bg-raise));
  }

  .step-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .period { color: var(--accent); font-size: 0.75rem; }
  .now-tag {
    font-size: 0.66rem;
    color: var(--bg);
    background: var(--accent);
    padding: 0.15em 0.7em;
    border-radius: 999px;
    font-weight: 700;
  }
  h3 { font-size: 1.12rem; margin: 0.2rem 0 0.25rem; }
  .step-text { color: var(--text-dim); font-size: 0.92rem; }

  .fact {
    margin-top: 0.5rem;
    padding: 0.4rem 0.75rem;
    border-left: 2px solid var(--accent-warm);
    background: color-mix(in oklch, var(--accent-warm) 6%, transparent);
    border-radius: 0 8px 8px 0;
    font-size: 0.85rem;
  }
  .fact-label { color: var(--accent-warm); }

  .step-achievements {
    list-style: none;
    padding: 0;
    margin: 0.55rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* ================= трофейная полка ================= */
  .shelf {
    border: 1px solid color-mix(in oklch, var(--accent) 18%, var(--line));
    border-radius: calc(var(--radius) + 6px);
    background:
      radial-gradient(40rem 18rem at 100% 0%, color-mix(in oklch, var(--accent) 6%, transparent), transparent 60%),
      color-mix(in oklch, var(--bg-raise) 85%, transparent);
    padding: 1.15rem 1.2rem 1.2rem;
    box-shadow: inset 0 1px 0 color-mix(in oklch, var(--text) 7%, transparent);
  }

  .shelf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .shelf-title { color: var(--accent); font-size: 0.78rem; }
  .shelf-count { color: var(--text-dim); font-size: 0.72rem; }

  .xp {
    margin-top: 0.65rem;
    height: 7px;
    border-radius: 999px;
    background: color-mix(in oklch, var(--text) 8%, transparent);
    overflow: clip;
  }
  .xp-fill {
    height: 100%;
    width: 100%;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      color-mix(in oklch, var(--accent) 70%, transparent),
      var(--accent) 40%,
      color-mix(in oklch, var(--accent-warm) 80%, var(--accent))
    );
    box-shadow: 0 0 14px color-mix(in oklch, var(--accent) 45%, transparent);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .xp-fill {
        animation: xp-grow linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 80%;
      }
      @keyframes xp-grow { from { width: 0; } to { width: 100%; } }
    }
  }

  .tiles {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(126px, 100%), 1fr));
    gap: 0.55rem;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.75rem 0.5rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raise);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .tile:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--accent) 50%, transparent);
    box-shadow: 0 6px 20px color-mix(in oklch, var(--accent) 15%, transparent);
  }

  .slot {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    border-radius: 12px;
    background: color-mix(in oklch, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--accent) 35%, transparent);
    margin-bottom: 0.45rem;
  }

  .tile.rare { border-color: color-mix(in oklch, var(--accent-warm) 40%, transparent); }
  .tile.rare .slot {
    background: color-mix(in oklch, var(--accent-warm) 12%, transparent);
    border-color: color-mix(in oklch, var(--accent-warm) 55%, transparent);
    box-shadow: 0 0 12px color-mix(in oklch, var(--accent-warm) 25%, transparent);
  }
  .tile.rare:hover {
    border-color: var(--accent-warm);
    box-shadow: 0 6px 20px color-mix(in oklch, var(--accent-warm) 22%, transparent);
  }
  .rare-star {
    position: absolute;
    top: 0.35rem;
    right: 0.5rem;
    font-size: 0.7rem;
    color: var(--accent-warm);
  }

  .t-title { font-weight: 680; font-size: 0.8rem; line-height: 1.25; }
  .t-note { color: var(--text-dim); font-size: 0.68rem; line-height: 1.35; margin-top: 0.15rem; }
</style>
