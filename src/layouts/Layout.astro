---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import profile from '../data/profile.json';

// Preload двух критичных подмножеств: без него текст ждёт загрузки шрифта
// уже после разбора CSS, и LCP заметно позже. Остальные подмножества
// (greek, vietnamese и т.п.) браузер не скачивает — их отсекает unicode-range.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interCyrillic from '@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const { title, description, ogImage = '/og.png' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Teamlead',
  worksFor: { '@type': 'Organization', name: 'Почта Mail.ru' },
  url: Astro.site?.href,
  email: `mailto:${profile.contacts.email}`,
  sameAs: [profile.contacts.github, profile.contacts.telegram],
  knowsAbout: ['Go', 'Backend', 'Архитектура систем', 'Управление командой'],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interCyrillic} crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="samoy.love" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#191c24" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} is:inline />
    <!-- Переходы между страницами: обложка карточки «перелетает» в шапку
         проекта. Скрипты после этого обязаны переинициализироваться по
         astro:page-load — иначе при возврате на главную сцена мертва. -->
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">К основному содержимому</a>
    <slot />
  </body>
</html>
